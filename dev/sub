#!/bin/bash
set -euo pipefail

# Change directory to the root of the project
cd "/mnt/c/Users/Rimmel Botond/Documents/bme/hatodikfelev/onlab/moq-rs"
# Use debug logging by default
export RUST_LOG="${RUST_LOG:-debug}"

# Connect to localhost by default.
HOST="${HOST:-localhost}"
PORT="${PORT:-4443}"
ADDR="${ADDR:-$HOST:$PORT}"

# Use the broadcast name "bbb" by default
NAME="${NAME:-bbb}"


# Combine the host and name into a URL.
URL="${URL:-"https://$ADDR/$NAME"}"

# Optional: subscriber-side rate limit (pick one of the envs)
SUB_RATE_LIMIT_MBPS="${SUB_RATE_LIMIT_MBPS:-10}"   # e.g. 1.5
SUB_RATE_LIMIT_BPS="${SUB_RATE_LIMIT_BPS:-}"     # e.g. 1500000

# Optional: initial RTT hint in ms
INITIAL_RTT_MS="${INITIAL_RTT_MS:-50}"      # e.g. 50

# Build CLI args for moq-sub
ARGS=""

# Convert Mbps -> bps if provided
if [ -n "$SUB_RATE_LIMIT_MBPS" ]; then
  if command -v bc >/dev/null 2>&1; then
    SUB_RATE_LIMIT_BPS=$(echo "$SUB_RATE_LIMIT_MBPS * 1000000" | bc -l | cut -d. -f1)
  else
    SUB_RATE_LIMIT_BPS=$(awk "BEGIN {printf \"%.0f\", $SUB_RATE_LIMIT_MBPS * 1000000}")
  fi
fi

# Attach flags understood by moq-sub's Config
if [ -n "$SUB_RATE_LIMIT_BPS" ]; then
  ARGS="$ARGS --rate-limit-bps $SUB_RATE_LIMIT_BPS"
fi
if [ -n "$INITIAL_RTT_MS" ]; then
  ARGS="$ARGS --initial-rtt-ms $INITIAL_RTT_MS"
fi

cargo run --bin moq-sub -- --name "$NAME" "$URL" $ARGS "$@" | ffplay -
